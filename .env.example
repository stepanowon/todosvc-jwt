# 이 파일을 .env로 복사해 값을 설정하세요. (.env는 git에 커밋되지 않습니다)

# 서버 포트
PORT=3000

# JWT 서명 비밀키 (운영 환경에서는 반드시 길고 무작위한 값으로 설정)
JWT_SECRET_KEY=change-this-to-a-long-random-secret

# 서명 알고리즘: HS256 | HS384 | HS512
JWT_ALGORITHM=HS512

# 토큰 발급자(iss)
JWT_ISSUER=jwt test server

# 만료 시간: jose 시간 표현식(30m, 1h, 7d 등) 또는 초 단위 숫자
JWT_ACCESS_TOKEN_EXPIRES_IN=1h
JWT_REFRESH_TOKEN_EXPIRES_IN=7d
