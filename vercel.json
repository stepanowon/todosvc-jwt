{
    "version": 2,
    "builds": [
        {
            "src": "**/index.js",
            "use": "@vercel/node",
            "config": {
                "includeFiles": "node_modules/jose/**"
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/build"
        }
    ]
  }